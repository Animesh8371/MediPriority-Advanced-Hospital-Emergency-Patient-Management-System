# Copy this file to .env (same folder as this file, the project root) and
# fill in your real values.
#
# The server now loads .env automatically at startup -- it checks the
# current directory and a few parent directories, so this works whether you
# run the .exe from backend/build/, from backend/, or from the project root,
# and regardless of whether your terminal is cmd.exe, PowerShell, or bash.
# A real OS environment variable (if you set one) always overrides the
# matching value in this file, so Docker/CI setups are unaffected.

MEDIPRIORITY_DB_HOST=127.0.0.1
MEDIPRIORITY_DB_PORT=3306
MEDIPRIORITY_DB_USER=root
MEDIPRIORITY_DB_PASSWORD=your_password
MEDIPRIORITY_DB_NAME=medipriority
MEDIPRIORITY_API_PORT=8080
